 function update(s){const year=s.calendarYear,bankProgress=clamp((year-2025.05)/.95);waterfront.visible=bankProgress>0;waterfront.geometry.setDrawRange(0,Math.floor(waterfrontCount*bankProgress/3)*3);const pp=Number.isFinite(s.constructionProgress?.mayakovskyPark)?s.constructionProgress.mayakovskyPark:ease((year-1931)/2.46),fp=Number.isFinite(s.constructionProgress?.eternalFlame)?s.constructionProgress.eternalFlame:ease((year-1959)/.5);for(const path of paths){path.mesh.visible=path.year===1933?pp>0:year>=path.year;path.mesh.geometry.setDrawRange(0,path.year===1933?Math.floor(path.count*clamp(pp)/3)*3:path.count);if(path.year===1933)path.mesh.material.color.set(year<1962?'#b39c77':'#c0b5a2');}arch.visible=year>=park.archYear;earlyGate.visible=pp>.1&&year<park.archYear;memorial.visible=fp>0;clip.constant=fy+19*fp+.1;fire.visible=fp>=.999;fire.children.forEach((m,i)=>{m.scale.set(1+Math.sin(s.time*9+i)*.1,1+Math.sin(s.time*12+i*.8)*.22,1);m.rotation.y=s.time*.8+i;});}
