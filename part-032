export function prepareWorldPlacesData(){for(const b of GEO.buildings){const phase=factoryYears.get(b.id);if(!phase)continue;if(!Number.isFinite(b.sourceDate)){b.year=phase.year;b.ageSource='model-period';b.ageRule='Uralmash surveyed hall; modelled factory construction wave';}b.uralmashEarly=phase.early&&b.year<=1933;b.style=b.year<1950?'historicIndustrial':'modernIndustrial';}}
export function worldPlaceClearingYear(x,z,r=0){let year=9999;const f=WORLD_PLACES.flame;if(Math.abs(x-f.x)<25+r&&Math.abs(z-f.z)<20+r)year=f.startYear;const park=WORLD_PLACES.park;if(Math.abs(x-park.x)<1500&&Math.abs(z-park.z)<1800)for(const path of park.paths)for(let i=1;i<path.p.length;i++)if(segmentDistance(x,z,path.p[i-1],path.p[i])<path.width/2+r)year=Math.min(year,path.year);if(pointInside(x,z,WORLD_PLACES.uralmash.polygon)){year=Math.min(year,1950);for(const b of earlyFactoryBodies){if(b&&Math.hypot(x-b.x,z-b.z)<180+r)year=1928;}}if(Math.abs(x)<1800&&z>-1300&&z<200)for(const path of WORLD_PLACES.embankment.paths)for(let i=1;i<path.p.length;i++)if(segmentDistance(x,z,path.p[i-1],path.p[i])<path.width/2+r)year=Math.min(year,2025.05);return year;}

function createPlaces(){
 const group=new THREE.Group(),park=WORLD_PLACES.park,f=WORLD_PLACES.flame,targets={mayakovskyPark:[park.x,heightAt(park.x,park.z)+5,park.z],eternalFlame:[f.x,heightAt(f.x,f.z)+8,f.z],modernEmbankment:[0,10,-250],uralmashWorks:[WORLD_PLACES.uralmash.x,heightAt(WORLD_PLACES.uralmash.x,WORLD_PLACES.uralmash.z)+18,WORLD_PLACES.uralmash.z]},paths=[];
 function ribbon(lines,color){const vertices=[];for(const line of lines)for(let i=1;i<line.p.length;i++){const a=line.p[i-1],b=line.p[i],length=Math.hypot(b[0]-a[0],b[1]-a[1]),n=Math.ceil(length/6),nx=(b[1]-a[1])/length*line.width/2,nz=-(b[0]-a[0])/length*line.width/2;for(let j=0;j<n;j++){const x=mix(a[0],b[0],j/n),z=mix(a[1],b[1],j/n),xx=mix(a[0],b[0],(j+1)/n),zz=mix(a[1],b[1],(j+1)/n);if(isWater((x+xx)/2,(z+zz)/2))continue;const points=[[x+nx,z+nz],[x-nx,z-nz],[xx+nx,zz+nz],[xx-nx,zz-nz]],v=points.map(p=>[p[0],heightAt(...p)+.82,p[1]]);if(points.some(p=>isWater(...p)))continue;for(const k of[0,1,2,2,1,3])vertices.push(...v[k]);}}const geo=new THREE.BufferGeometry();geo.setAttribute('position',new THREE.Float32BufferAttribute(vertices,3));geo.computeVertexNormals();const mesh=new THREE.Mesh(geo,new THREE.MeshStandardMaterial({color,roughness:.96}));group.add(mesh);return mesh;}
 for(const year of[1933,2000]){const mesh=ribbon(park.paths.filter(p=>p.year===year),year===1933?'#b39c77':'#bbb5a5');paths.push({mesh,year,count:mesh.geometry.attributes.position.count});}
 const waterfront=ribbon(WORLD_PLACES.embankment.paths,'#bdb9ad'),waterfrontCount=waterfront.geometry.attributes.position.count;
 const arch=new THREE.Group(),[ex,ez]=park.entrance,ground=heightAt(ex,ez);arch.position.set(ex,ground,ez);arch.rotation.y=-.17;group.add(arch);const ivory=new THREE.MeshStandardMaterial({color:'#dbcfb3',roughness:.78});for(const x of[-10,-4,4,10]){box(arch,ivory,x,5,0,2.4,10,5);box(arch,ivory,x,.5,0,3.1,1,6);box(arch,ivory,x,10.3,0,3.1,.7,5.8);}box(arch,ivory,0,11.4,0,23,1.5,5);for(const x of[-7,0,7]){const curve=new THREE.Mesh(new THREE.TorusGeometry(x===0?3:2.1,.42,5,18,Math.PI),ivory);curve.position.set(x,7.4,2.65);arch.add(curve);}box(arch,mats.gold,0,12.5,0,12,.35,5.2);
 const earlyGate=new THREE.Group();group.add(earlyGate);earlyGate.position.copy(arch.position);earlyGate.rotation.copy(arch.rotation);for(const x of[-8,8])box(earlyGate,mats.wood,x,3,0,.65,6,.65);box(earlyGate,mats.wood,0,5.7,0,16.6,.7,.6);
