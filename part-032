export function createCityActivities({routeFor,samplePath}){
 const group=new THREE.Group();group.name='City places and street traffic';const places=createPlaces();group.add(places.group);const targets={...places.targets};
 const routes={horse:routeFor(r=>r.name==='проспект Ленина',[0,0],2600,1850)};
  const trafficRoutes=[['проспект Ленина',[0,0]],['улица 8 Марта',[-250,400]],['улица Малышева',[500,440]],['улица Свердлова',[300,-1500]]].map(([name,anchor])=>routeFor(r=>r.name===name,anchor,4200));
 const traffic=makeTraffic(80);group.add(traffic.group);const horseCarts=Array.from({length:6},()=>{const g=carriage();group.add(g);return g;});
  function pose(route,d,year,off=0){const p=samplePath(route,d),x=p.x+Math.cos(p.angle)*off,z=p.z-Math.sin(p.angle)*off,on=route.parts?.find(v=>year>=v.phase.start&&year<v.phase.end&&v.phase.p.slice(1).some((q,i)=>segmentDistance(x,z,v.phase.p[i],q)<=v.phase.width/2+.2));return on?{x,z,y:roadHeightAt(on.r,x,z),angle:p.angle}:null;}
