  let last={};function update(s){places.update(s);const year=s.calendarYear,p=s.eventProgress||0,trafficCount=year<1970?0:year<1980?16:year<1985?28:year<1990?50:80,poses=[];for(let i=0;i<trafficCount;i++){const route=trafficRoutes[i%4],cycle=route.total/11+18,t=(s.time+i*19.13)%cycle;if(t<9||t>cycle-9)continue;const pp=pose(route,(t-9)*11,year,-1.65);if(pp)poses.push(pp);}traffic.update(poses);
